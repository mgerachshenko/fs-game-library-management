generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id          String  @id
  name        String
  displayName String
  bio         String?
  avatarUrl   String?
  updatedAt   DateTime
}

model Game {
  id       Int     @id @default(autoincrement())
  title    String
  image    String
  category String
  isOwned  Boolean @default(false)
}