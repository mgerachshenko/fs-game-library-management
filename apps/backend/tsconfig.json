{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "moduleResolution": "node",
        "outDir": "./dist",
        "rootDir": ".",
        "sourceMap": true,
        "lib": ["ES2020"],
        "types": ["node"],
        "ignoreDeprecations": "6.0"
    },
    "include": ["src/**/*", "tests/**/*", "prisma/**/*"],
    "exclude": ["node_modules", "dist"]
}
